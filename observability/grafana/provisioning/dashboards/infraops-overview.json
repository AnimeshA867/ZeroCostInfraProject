{
  "id": null,
  "uid": "zerocost-infraops",
  "title": "ZeroCost-InfraOps Live Telemetry",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "API Request Rate (RPS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler, status)",
          "legendFormat": "{{handler}} [{{status}}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency (Seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Orders Queued in SQS/DynamoDB",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(orders_processed_total{status=\"success\"})",
          "legendFormat": "Successful Orders"
        }
      ]
    }
  ]
}
